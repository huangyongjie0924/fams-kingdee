# ============ 凭据与密钥（务必不要提交） ============
config.yaml
deploy/config.yaml
.env
deploy/.env

# 证书：自签证书里嵌着部署机地址（CN / SAN），属本机环境产物。
# 换台机器就必须重新生成，留在仓库里只有暴露内网地址的作用。
# 生成方式见 README「首次拉取后」第 3 步。
cert/
deploy/cert/
*.crt
*.key
*.pem

# ============ 构建产物 ============
bin/
*.exe
*.exe~
asset-mgr
asset-mgr-linux
asset-mgr-darwin
*.tar.gz

# 前端产物（由 npm run build 生成，会被 go:embed 打进二进制）
web/dist/
web/node_modules/

# ============ 运行时数据 ============
uploads/
*.log

# orgreset 生成的备份（含部门/员工/公司原始数据，不要提交）
orgreset-backup/

# ============ 编辑器与系统 ============
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
__pycache__/
*.pyc
