# 换行符策略：入库统一 LF，避免 Windows 开发 / Linux 部署不一致
* text=auto eol=lf

# Shell 脚本必须保持 LF，否则在 Linux 上会报 bad interpreter: /bin/bash^M
*.sh text eol=lf
asset-mgr.service text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.exe binary
*.png binary
*.jpg binary
*.ico binary
*.crt binary
*.key binary
*.tar.gz binary
